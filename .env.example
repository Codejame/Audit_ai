# Application Settings
APP_NAME="Intelligent Document Extraction Platform"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Persistence & Storage
DATABASE_URL=sqlite:///./backend/data/documents.db
UPLOAD_DIR=./backend/uploads

# Processing Constraints
MAX_PAGE_LIMIT=3
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png
MAX_UPLOAD_SIZE_MB=25

# LLM & Extraction Service Provider
# Options: 'gemini' | 'openai' | 'mock' (mock provides deterministic extraction for evaluation/testing)
LLM_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration (Optional alternate provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Financial Validation Settings
FINANCIAL_TOLERANCE=1.00
